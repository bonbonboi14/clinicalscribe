# ClinicalScribe Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# TRANSCRIPTION API
# ============================================================================
# OpenAI API key for Whisper transcription
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Whisper model to use (whisper-1 is the current model)
WHISPER_MODEL=whisper-1

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# Port for the web server (default: 8000)
SERVER_PORT=8000

# Host binding (do not change unless you know what you're doing)
# 127.0.0.1 = localhost only (phone mode disabled)
# 0.0.0.0 = all interfaces (phone mode enabled)
SERVER_HOST=127.0.0.1

# ============================================================================
# PHONE MODE SETTINGS
# ============================================================================
# How long pairing codes remain valid (in minutes)
PAIRING_CODE_EXPIRY_MINUTES=15

# Maximum upload size from phone (in MB)
MAX_UPLOAD_SIZE_MB=500

# Chunk size for uploads (in MB)
CHUNK_SIZE_MB=5

# ============================================================================
# STORAGE PATHS
# ============================================================================
# Directory for audio recordings
AUDIO_DIRECTORY=data/audio

# Directory for transcripts and other artifacts
ARTIFACT_DIRECTORY=data/artifacts

# ============================================================================
# SAFETY ENGINE (Optional)
# ============================================================================
# Enable or disable the clinical safety checks
SAFETY_ENGINE_ENABLED=true

# ============================================================================
# LOGGING
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location (leave empty to log to console only)
LOG_FILE=

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Never commit your .env file to version control
# 2. Keep your OpenAI API key secret
# 3. Only enable phone mode when actively recording
# 4. Audio is sent to OpenAI servers for transcription
# 5. Configure Windows Firewall to allow private network access only
