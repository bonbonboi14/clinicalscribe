# Copy this file to .env for local development. Never commit .env.
CLINICAL_SCRIBE_ENV=development
CLINICAL_SCRIBE_CONFIG=config/config.yaml

# Required only for an explicitly requested, manual GitHub push.
# Use a fine-grained token with access only to the approved destination repo.
CLINICAL_SCRIBE_GITHUB_TOKEN=

# Optional cloud note provider credentials. Local generation remains the default.
# CLINICAL_SCRIBE_CLOUD_API_KEY=

